{
  "name": "mcp-testrail-sync",
  "version": "0.1.0-beta.2",
  "description": "MCP server for TestRail: create and read test cases, sections and labels from prompts in Claude, OpenCode, Codex or Copilot. One project, one suite, no update or delete.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mcp-testrail-sync": "index.js"
  },
  "files": [
    "index.js",
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node index.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "testrail",
    "test-case",
    "test-cases",
    "test-management",
    "qa",
    "testing",
    "claude",
    "claude-code",
    "opencode",
    "codex",
    "copilot",
    "ai"
  ],
  "author": "Vitalii Mykhailiuk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mykhailiuk-chanel/mcp-testrail-sync.git"
  },
  "homepage": "https://github.com/mykhailiuk-chanel/mcp-testrail-sync#readme",
  "bugs": {
    "url": "https://github.com/mykhailiuk-chanel/mcp-testrail-sync/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
